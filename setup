#!/bin/sh
# One-time setup after cloning. Run it with: ./setup
# It checks for the tools you need, installs dependencies, then asks for your API key.
# It is plain shell on purpose: it must work before Node.js is installed.
#
# With --check, it only reports what's missing instead of installing or prompting -
# for a coding agent to run to verify things are ready, without risking a hang on input.
set -e
cd "$(dirname "$0")"
check_only=false
[ "$1" = "--check" ] && check_only=true

pass() { printf '  ok       %s\n' "$1"; }
fail() { printf '  MISSING  %s\n' "$1"; echo; echo "Fix that, then run ./setup again."; exit 1; }

if command -v node >/dev/null 2>&1; then
  version=$(node --version)
  major=${version#v}; major=${major%%.*}
  if [ "$major" -ge 24 ]; then
    pass "Node.js $version"
  else
    fail "Node.js 24 or newer (you have $version) - https://nodejs.org"
  fi
else
  fail "Node.js - install it from https://nodejs.org (npm comes with it)"
fi

if command -v npm >/dev/null 2>&1; then
  pass "npm $(npm --version)"
else
  fail "npm - it normally comes with Node.js"
fi

if command -v git >/dev/null 2>&1; then
  pass "git"
else
  fail "git - https://git-scm.com"
fi

if [ -d node_modules ]; then
  pass "dependencies installed"
elif $check_only; then
  fail "dependencies - run: ./setup"
else
  printf '  ...      installing dependencies\n'
  npm install --silent
  pass "dependencies installed"
fi

key=${OPENROUTER_API_KEY:-$(sed -n 's/^OPENROUTER_API_KEY=//p' .env 2>/dev/null || true)}
if [ -n "$key" ] && [ "$key" != "your-key" ]; then
  pass "OPENROUTER_API_KEY"
elif $check_only; then
  fail "OPENROUTER_API_KEY - run ./setup in your terminal (see \"Don't have an API key yet?\" in README.md)"
else
  npx tsx scripts/set-key.ts
fi

echo "All good. Fire up your coding agent and say \"coach me\"."
